{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "modelbot://tools/browser_tabs.json",
  "title": "browser_tabs",
  "description": "List, open, select, or close tabs (single tool; action discriminator).",
  "type": "object",
  "properties": {
    "action": {
      "type": "string",
      "enum": [
        "list",
        "new",
        "select",
        "close"
      ]
    },
    "tab_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "url": {
      "type": [
        "string",
        "null"
      ],
      "description": "For action=new."
    }
  },
  "required": [
    "action",
    "tab_id",
    "url"
  ],
  "additionalProperties": false
}
