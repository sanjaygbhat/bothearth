{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "modelbot://tools/browser_upload.json",
  "title": "browser_upload",
  "description": "Attach workspace file(s) to a file input (upload gate).",
  "type": "object",
  "properties": {
    "snapshot_id": {
      "type": "string"
    },
    "ref": {
      "type": "string"
    },
    "paths": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "description": "Paths under /workspace only."
    }
  },
  "required": [
    "snapshot_id",
    "ref",
    "paths"
  ],
  "additionalProperties": false
}
