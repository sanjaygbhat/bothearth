# ModelBot computer image — Debian bookworm-slim + Playwright Chromium sandbox.
#
#   docker build -f Dockerfile.computer -t modelbot/computer:dev .

ARG DEBIAN_VERSION=bookworm-slim
FROM debian:${DEBIAN_VERSION} AS base

ARG TARGETARCH
ARG NODE_VERSION=22.23.2
ARG PLAYWRIGHT_VERSION=1.59.1

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    PLAYWRIGHT_BROWSERS_PATH=/opt/pw-browsers \
    NODE_PATH=/opt/playwright/node_modules \
    PATH=/usr/local/node/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Runtime packages only (no compilers / build-essential). curl/xz-utils are
# build-only: the Node tarball lands in this same RUN so their purge shrinks the
# layer that added them. This browser image includes an operator desktop; the
# separate Dockerfile.shell keeps model shell execution away from browser data.
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
      ca-certificates \
      curl \
      xz-utils \
      tini \
      xvfb xauth xdotool openbox xterm pcmanfm ffmpeg \
      tzdata \
      locales \
      fonts-liberation \
      fonts-dejavu-core \
      fonts-noto-core \
      libnss3 \
      libnspr4 \
      libatk1.0-0 \
      libatk-bridge2.0-0 \
      libcups2 \
      libdrm2 \
      libdbus-1-3 \
      libxkbcommon0 \
      libxcomposite1 \
      libxdamage1 \
      libxfixes3 \
      libxrandr2 \
      libgbm1 \
      libasound2 \
      libpango-1.0-0 \
      libcairo2 \
      libatspi2.0-0 \
      libx11-6 \
      libx11-xcb1 \
      libxcb1 \
      libxext6 \
      libxshmfence1 \
      libglib2.0-0; \
    sed -i 's/^# *en_US.UTF-8/en_US.UTF-8/' /etc/locale.gen; \
    locale-gen en_US.UTF-8; \
    update-ca-certificates; \
    case "${TARGETARCH}" in \
      amd64) NODE_ARCH=x64 ;; \
      arm64) NODE_ARCH=arm64 ;; \
      *) echo "unsupported TARGETARCH=${TARGETARCH}" >&2; exit 1 ;; \
    esac; \
    curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${NODE_ARCH}.tar.xz" \
      -o /tmp/node.tar.xz; \
    mkdir -p /usr/local/node; \
    tar -xJf /tmp/node.tar.xz -C /usr/local/node --strip-components=1; \
    rm -f /tmp/node.tar.xz; \
    apt-get purge -y --auto-remove curl xz-utils; \
    rm -rf /var/lib/apt/lists/* /tmp/*; \
    apt-get clean; \
    node -v; npm -v

ENV LANG=en_US.UTF-8 \
    LC_ALL=en_US.UTF-8

# Unprivileged users: browser (1001) owns profile; agent (1002) owns /workspace.
RUN groupadd --gid 1001 browser \
 && useradd --uid 1001 --gid 1001 --create-home --home-dir /home/browser --shell /bin/bash browser \
 && groupadd --gid 1002 agent \
 && useradd --uid 1002 --gid 1002 --create-home --home-dir /home/agent --shell /bin/bash agent \
 && mkdir -p /home/browser/profile /home/browser/.cache /workspace /opt/pw-browsers /opt/playwright \
 && chown -R browser:browser /home/browser \
 && chmod 755 /home/browser \
 && chmod 0700 /home/browser/profile \
 && chown agent:agent /workspace \
 && chmod 755 /workspace \
 && touch /home/browser/profile/.keep \
 && chown browser:browser /home/browser/profile/.keep \
 && chmod 0600 /home/browser/profile/.keep

# Playwright pin + Chromium only (never channel: chrome). --with-deps for OS libs;
# we already seeded common libs above; install-deps fills any gaps then we drop lists.
WORKDIR /opt/playwright
RUN npm init -y \
 && npm install --omit=dev "playwright@${PLAYWRIGHT_VERSION}" \
 && npx playwright install --with-deps chromium \
 && npm cache clean --force \
 && rm -rf /var/lib/apt/lists/* /root/.npm /tmp/* \
 && chown -R browser:browser /opt/playwright /opt/pw-browsers \
 && chmod -R u=rwX,g=,o= /opt/pw-browsers \
 && chmod -R a+rX /opt/playwright

VOLUME ["/workspace", "/home/browser/profile"]

USER browser
WORKDIR /workspace
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["sleep", "infinity"]

# Final stage: computer-server. Guarded ARG so `--target base` builds without
# that tree.
FROM base AS final
USER root
RUN apt-get update && apt-get install -y --no-install-recommends xclip dbus-x11 && rm -rf /var/lib/apt/lists/*
ARG COMPUTER_SERVER_DIR=computer-server
USER root
COPY LICENSE NOTICE THIRD_PARTY_NOTICES.md /usr/share/doc/modelbot/
COPY sandbox/Moby-LICENSE.txt sandbox/Moby-NOTICE.txt /usr/share/doc/modelbot/
# Shared contracts/protocol — computer-server imports via ../../src/*
COPY src/protocol /opt/src/protocol
COPY src/types /opt/src/types
COPY src/tools /opt/src/tools
COPY ${COMPUTER_SERVER_DIR}/ /opt/computer-server/
# Layout: /opt/computer-server/src/*.ts imports ../../src → /opt/src
RUN mkdir -p /opt/computer-server-root \
 && mv /opt/computer-server /opt/computer-server-root/computer-server \
 && mv /opt/src /opt/computer-server-root/src \
 && ln -s /opt/computer-server-root/computer-server /opt/computer-server \
 && mkdir -p /opt/computer-server-root/computer-server/node_modules \
 && ln -sf /opt/playwright/node_modules/playwright /opt/computer-server-root/computer-server/node_modules/playwright \
 && ln -sf /opt/playwright/node_modules/playwright-core /opt/computer-server-root/computer-server/node_modules/playwright-core \
 && chown -R agent:agent /opt/computer-server-root \
 && chmod -R a+rX /opt/computer-server-root
ENV NODE_PATH=/opt/playwright/node_modules MODELBOT_DESKTOP=1
USER browser
WORKDIR /workspace
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["sleep", "infinity"]
