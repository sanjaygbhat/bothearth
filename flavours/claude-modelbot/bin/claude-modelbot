#!/usr/bin/env bash
# Thin Claude Code launcher: ensure daemon + connect, then claude --plugin-dir.
set -euo pipefail

FLAVOUR_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
REPO_ROOT="$(cd "$FLAVOUR_ROOT/../.." && pwd)"
CLI_TS="${REPO_ROOT}/src/cli/index.ts"

run_modelbot() {
  if [[ -n "${MODELBOT_BIN:-}" ]]; then
    "$MODELBOT_BIN" "$@"
  elif command -v modelbot >/dev/null 2>&1; then
    modelbot "$@"
  else
    node --experimental-strip-types "$CLI_TS" "$@"
  fi
}

start_daemon_bg() {
  if [[ -n "${MODELBOT_BIN:-}" ]]; then
    nohup "$MODELBOT_BIN" start >/dev/null 2>&1 &
  elif command -v modelbot >/dev/null 2>&1; then
    nohup modelbot start >/dev/null 2>&1 &
  else
    nohup node --experimental-strip-types "$CLI_TS" start >/dev/null 2>&1 &
  fi
}

: "${MODELBOT_TOKEN:?set MODELBOT_TOKEN to the daemon /mcp bearer (same as MODELBOT_MCP_TOKEN)}"
export MODELBOT_MCP_TOKEN="${MODELBOT_MCP_TOKEN:-$MODELBOT_TOKEN}"
export MODELBOT_ENDPOINT="${MODELBOT_ENDPOINT:-http://127.0.0.1:7777}"

ensure_daemon() {
  if curl -sf --max-time 2 "${MODELBOT_ENDPOINT}/healthz" >/dev/null 2>&1; then
    return 0
  fi
  echo "claude-modelbot: starting modelbot daemon on ${MODELBOT_ENDPOINT}" >&2
  start_daemon_bg
  for _ in $(seq 1 50); do
    if curl -sf --max-time 1 "${MODELBOT_ENDPOINT}/healthz" >/dev/null 2>&1; then
      return 0
    fi
    sleep 0.1
  done
  echo "claude-modelbot: daemon healthz failed at ${MODELBOT_ENDPOINT}/healthz" >&2
  exit 1
}

ensure_daemon
# Also write user/project MCP config (idempotent); plugin ships its own .mcp.json.
run_modelbot connect claude
echo "claude-modelbot: plugin-dir=$FLAVOUR_ROOT (modelbot MCP connected)" >&2

if ! command -v claude >/dev/null 2>&1; then
  echo "claude-modelbot: 'claude' not found on PATH" >&2
  exit 127
fi
exec claude --plugin-dir "$FLAVOUR_ROOT" "$@"
